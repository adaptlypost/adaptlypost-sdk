{
  "name": "@adaptlypost/sdk",
  "version": "0.2.0",
  "description": "TypeScript client for the AdaptlyPost API",
  "keywords": [
    "adaptlypost",
    "social-media",
    "scheduling",
    "sdk",
    "api"
  ],
  "homepage": "https://adaptlypost.com",
  "bugs": {
    "url": "https://github.com/adaptlypost/adaptlypost-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adaptlypost/adaptlypost-sdk.git"
  },
  "license": "MIT",
  "author": "AdaptlyPost <support@adaptlypost.com> (https://adaptlypost.com)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "scripts": {
    "generate": "openapi-typescript https://post.adaptlypost.com/post/api/v1/openapi.json -o src/generated/openapi.ts --default-non-nullable false",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  }
}
